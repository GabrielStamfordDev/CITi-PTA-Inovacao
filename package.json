{
  "name": "cuida-app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"ts-node-dev --poll --exit-child -r tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules --no-notify src/server.ts\" \"prisma generate --watch\"",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "generate": "prisma generate",
    "migration": "prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "seed:prod": "node dist/prisma/seed.js",
    "rag:ingest": "ts-node-dev --transpile-only src/rag/ingestCli.ts",
    "rag:ingest:prod": "node dist/src/rag/ingestCli.js",
    "rag:eval": "ts-node-dev --transpile-only src/rag/evaluateCli.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
