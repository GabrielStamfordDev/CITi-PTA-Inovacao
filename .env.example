# Aplicação
PROJECT_NAME=cuida
SERVER_PORT=3001

# Banco de Dados PostgreSQL (compatível com docker-compose.yml)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=docker
DATABASE_DB=cuida
DATABASE_URL=${DATABASE_TYPE}://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# Sessão segura JWT HttpOnly (opcional em dev; obrigatório em produção)
# AUTH_SECRET=gere_uma_chave_aleatoria_longa_aqui

# Assistente CuiDA com Google Gemini (opcional: sem chave usa RAG científico local nos PDFs)
# GEMINI_API_KEY=sua_chave_do_google_ai_studio

# E-mail de recuperação de senha (opcional: "console" imprime o código no terminal)
MAIL_PROVIDER=console
# BREVO_API_KEY=sua_chave_brevo
# RESEND_API_KEY=sua_chave_resend
MAIL_FROM_NAME=CuiDA Apoio
MAIL_FROM_EMAIL=cuida.apoio@gmail.com
