# Aplicação
PROJECT_NAME=cuida
SERVER_PORT=3001

# Banco de Dados PostgreSQL
# Local (Docker): DATABASE_URL e DIRECT_URL apontam para o mesmo Postgres local.
# Produção (Neon): DATABASE_URL = URL com Connection Pooling (-pooler) | DIRECT_URL = URL direta (sem -pooler).
DATABASE_URL="postgresql://postgres:docker@localhost:5432/cuida"
DIRECT_URL="postgresql://postgres:docker@localhost:5432/cuida"

# Sessão segura JWT HttpOnly (opcional em dev; obrigatório em produção)
# AUTH_SECRET=gere_uma_chave_aleatoria_longa_aqui

# Assistente CuiDA com Google Gemini (opcional: sem chave usa RAG científico local nos PDFs)
# GEMINI_API_KEY=sua_chave_do_google_ai_studio

# E-mail de recuperação de senha (local: "console" exibe o código no terminal | produção: "brevo")
MAIL_PROVIDER=console
# BREVO_API_KEY=sua_chave_brevo
# RESEND_API_KEY=sua_chave_resend
MAIL_FROM_NAME=CuiDA Apoio
MAIL_FROM_EMAIL=cuida.apoio@gmail.com
