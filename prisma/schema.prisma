generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String               @unique
  senha               String
  dataNascimento      String?
  idade               Int?
  pessoaComAlzheimer  String?
  parentesco          String?
  estagioDaDoenca     String?
  cidade              String?
  estado              String?
  inscricoes          Inscricao[]
  passwordResetTokens PasswordResetToken[]
  forumMessages       ForumMessage[]
  forumMemberships    ForumMembership[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ForumRoom {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  nome        String
  descricao   String
  categoria   String
  icone       String            @default("messages-square")
  cor         String            @default("emerald")
  padrao      Boolean           @default(false)
  ordem       Int               @default(0)
  createdAt   DateTime          @default(now())
  messages    ForumMessage[]
  memberships ForumMembership[]

  @@index([ordem])
}

model ForumMembership {
  id       Int       @id @default(autoincrement())
  userId   Int
  roomId   Int
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     ForumRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

model ForumMessage {
  id        Int       @id @default(autoincrement())
  userId    Int
  roomId    Int
  conteudo  String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      ForumRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([roomId, createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used])
}

model Evento {
  id               Int         @id @default(autoincrement())
  titulo           String
  data             String
  horario          String
  local            String
  descricao        String
  precisaInscricao Boolean     @default(true)
  inscricoes       Inscricao[]
  createdAt        DateTime    @default(now())
}

model Inscricao {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventoId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventoId]) // Evita inscrição duplicada no mesmo evento
}

model LinkApoio {
  id        Int    @id @default(autoincrement())
  categoria String // "Associacoes", "WhatsApp", "Facebook"
  titulo    String
  subtitulo String
  url       String
  icone     String
}

model Artigo {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  titulo   String
  resumo   String
  conteudo String // Texto estruturado do artigo
  icone    String
}

model Faq {
  id       Int    @id @default(autoincrement())
  pergunta String
  resposta String
  ordem    Int
}

model RagDocument {
  id                  Int        @id @default(autoincrement())
  filename            String     @unique
  title               String?
  authorOrInstitution String?
  publicationYear     String?
  documentType        String?
  focus               String?
  metadataSource      String?
  fileHash            String
  pageCount           Int?
  totalWords          Int?
  status              String     @default("processed") // processed | needs_ocr | failed | removed
  errorMessage        String?
  ingestedAt          DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  chunks              RagChunk[]

  @@index([status])
}

model RagChunk {
  id             Int                          @id @default(autoincrement())
  chunkKey       String                       @unique
  documentId     Int
  content        String
  sectionTitle   String?
  startPage      Int
  endPage        Int
  position       Int
  contentHash    String
  embeddingModel String?
  embeddingDim   Int?
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                     @default(now())
  document       RagDocument                  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@index([startPage, endPage])
}
